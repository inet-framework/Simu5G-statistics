config *.ue[*].app[0].localPort 1000
config *.ue[*].app[1].localPort 10000
config *.server.app[*].samplingTime 0.02s
config *.server.app[0..9].destAddress "\"ue[\"+string(ancestorIndex(0))+\"]\""
config *.server.app[10..19].destAddress "\"ue[\"+string(ancestorIndex(0)-10)+\"]\""
