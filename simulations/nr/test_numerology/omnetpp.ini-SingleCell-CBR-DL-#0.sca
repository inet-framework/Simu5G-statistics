config *.ue[*].servingNodeId 1
config *.ue[*].nrServingNodeId 2
config **.mobility.constraintAreaMaxX 700m
config **.mobility.constraintAreaMaxY 400m
config **.mobility.constraintAreaMinX 200m
config **.mobility.constraintAreaMinY 200m
config *.ue[*].mobility.typename RandomWaypointMobility
config *.ue[*].mobility.initialX uniform(200m,700m)
config *.ue[*].mobility.initialY uniform(200m,400m)
config *.ue[*].mobility.speed uniform(5mps,15mps)
config *.ue[*].numApps 2
config *.server.numApps 10*2
config *.bearerConfigurator.onDemandDrbs "[\n    {coreNetwork: \"epc\", filters: [\"expr(ipv4.typeOfService == 10)\"], lcg: 3, rlcMode: \"UM\", legs: [\"MCG\", \"SCG\"], primaryPath: \"SCG\"},\n    {coreNetwork: \"epc\", isDefault: true, lcg: 3, rlcMode: \"UM\"}\n    ]"
config *.ue[*].app[*].typename CbrReceiver
config *.ue[*].app[0].localPort 1000
config *.ue[*].app[1].localPort 10000
config *.server.app[*].samplingTime 0.02s
config *.server.app[0..9].destAddress "\"ue[\"+string(ancestorIndex(0))+\"]\""
config *.server.app[10..19].destAddress "\"ue[\"+string(ancestorIndex(0)-10)+\"]\""
config *.server.app[0..9].destPort 1000
config *.server.app[10..19].destPort 10000
config *.server.app[0..9].tos 0
config *.server.app[10..19].tos 10
config *.server.app[*].localPort 3088+ancestorIndex(0)
config *.server.app[*].typename CbrSender
config *.server.app[*].startTime uniform(0.01s,0.02s)
config **.routingRecorder.enabled false
config seed-set 0
