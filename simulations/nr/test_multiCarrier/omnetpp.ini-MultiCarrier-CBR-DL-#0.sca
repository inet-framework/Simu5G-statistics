config **.param-recording false
config image-path /home/andras/projects/Simu5G-fork/simu5g-fork/images
config output-scalar-file results/omnetpp.ini-MultiCarrier-CBR-DL-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-MultiCarrier-CBR-DL-#0.vec
