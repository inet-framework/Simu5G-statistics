version 3
run MultiCarrier-CBR-UL-0-20261123-20:23:01-3496
attr configname MultiCarrier-CBR-UL
attr datetime 20261123-20:23:01
attr datetimef 20261123-202301
attr experiment MultiCarrier-CBR-UL
attr inifile omnetpp.ini
attr iterationvars $numUe=10
attr iterationvarsd numUe=10
attr iterationvarsf numUe=10-
attr measurement $numUe=10
