config *.ue[*].cellularNic.nrPhy.componentCarrierModules "\"carrierAggregation.componentCarrier[0] carrierAggregation.componentCarrier[1]\""
config *.server.app[*].typename CbrReceiver
config *.server.app[*].localPort 1000+ancestorIndex(0)
config *.ue[*].app[*].destAddress "\"server\""
