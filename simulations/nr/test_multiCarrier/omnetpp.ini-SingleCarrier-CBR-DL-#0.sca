version 3
run SingleCarrier-CBR-DL-0-20261108-17:08:15-1213000
attr configname SingleCarrier-CBR-DL
attr datetime 20261108-17:08:15
attr datetimef 20261108-170815
attr experiment SingleCarrier-CBR-DL
attr inifile omnetpp.ini
attr iterationvars $numUe=10
attr iterationvarsd numUe=10
attr iterationvarsf numUe=10-
attr measurement $numUe=10
attr network simu5g.simulations.nr.networks.SingleCell_Standalone
attr processid 1213000
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar numUe 10
config **.param-recording false
config image-path /home/andras/projects/Simu5G-fork/simu5g-fork/images
config output-scalar-file results/omnetpp.ini-SingleCarrier-CBR-DL-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-SingleCarrier-CBR-DL-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 50s
config extends "SingleCarrier, CBR-DL"
config *.carrierAggregation.numComponentCarriers 1
config *.carrierAggregation.componentCarrier[0].carrierFrequency 2GHz
config *.carrierAggregation.componentCarrier[0].numBands 6
config *.gnb.cellularNic.numCarriers 1
config *.gnb.cellularNic.phy.componentCarrierModules "\"carrierAggregation.componentCarrier[0]\""
config *.ue[*].cellularNic.numNrCarriers 1
config *.ue[*].cellularNic.nrPhy.componentCarrierModules "\"carrierAggregation.componentCarrier[0]\""
config *.ue[*].app[*].typename CbrReceiver
config *.ue[*].app[*].localPort 1000
config *.server.app[*].samplingTime 0.02s
config *.server.app[*].destAddress "\"ue[\"+string(ancestorIndex(0))+\"]\""
config *.server.app[*].destPort 1000
config *.server.app[*].localPort 3088+ancestorIndex(0)
config *.server.app[*].typename CbrSender
config *.server.app[*].startTime uniform(0.01s,0.02s)
config *.server.app[*].packetSize 2000B
config network simu5g.simulations.nr.networks.SingleCell_Standalone
config **.routingRecorder.enabled false
config seed-set 0
config **.sctp.**.scalar-recording false
config **.sctp.**.vector-recording false
config **.vector-recording true
config **.mobility.constraintAreaMinZ 0m
config **.mobility.constraintAreaMaxZ 0m
config **.mobility.initFromDisplayString false
config **.eNodeBTxPower 40dBm
config **.sctp.nagleEnabled false
config **.sctp.enableHeartbeats false
config **.downlinkInterference true
config **.uplinkInterference true
config **.enableHandover true
config **.fbPeriod 10tti
config **.targetBler 0.01
config **.blerShift 5
config *.configurator.config "xmldoc(\"./demo.xml\")"
config *.gnb.mobility.initialX 300m
config *.gnb.mobility.initialY 300m
config *.numUe 10
config *.ue[*].servingNodeId 0
config *.ue[*].nrServingNodeId 1
config **.mobility.constraintAreaMaxX 700m
config **.mobility.constraintAreaMaxY 400m
config **.mobility.constraintAreaMinX 100m
config **.mobility.constraintAreaMinY 200m
config *.ue[*].mobility.typename RandomWaypointMobility
config *.ue[*].mobility.initialX uniform(100m,500m)
config *.ue[*].mobility.initialY uniform(200m,400m)
config *.ue[*].mobility.speed uniform(5mps,15mps)
config *.ue[*].numApps 1
config *.server.numApps 10

