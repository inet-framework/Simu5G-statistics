config *.ue[0].numEthInterfaces 1
config *.bearerConfigurator.staticDrbs "[\n    {coreNetwork: \"5gc\", ue: \"ue[0]\", drbId: 1, isDefault: true, lcg: 3, rlcMode: \"UM\"},\n    {coreNetwork: \"5gc\", ue: \"ue[0]\", drbId: 2, mappedQfis: [5], lcg: 1, rlcMode: \"UM\"}\n    ]"
