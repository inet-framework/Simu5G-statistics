config **.param-recording false
config image-path /home/andras/projects/Simu5G-fork/simu5g-fork/images
config output-scalar-file results/omnetpp.ini-CBR-DL-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-CBR-DL-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 20s
config extends ThreeSectorSite
config description "three sectors of one site; CBR DL traffic to UEs circling the mast"
config *.ue[*].numApps 1
config *.server.numApps 6
config *.ue[*].app[*].typename CbrReceiver
config *.ue[*].app[*].localPort 3000
config *.server.app[*].typename CbrSender
config *.server.app[*].packetSize 100B
config *.server.app[*].samplingTime 0.02s
config *.server.app[*].destAddress "\"ue[\" + string(ancestorIndex(0)) + \"]\""
config *.server.app[*].destPort 3000
config *.server.app[*].localPort 3088+ancestorIndex(0)
config *.server.app[*].startTime uniform(0s,0.02s)
config network simu5g.simulations.nr.networks.ThreeSectorSite_Standalone
config *.carrierAggregation.numComponentCarriers 1
config *.carrierAggregation.componentCarrier[0].numerologyIndex 0
config *.carrierAggregation.componentCarrier[0].carrierFrequency 2GHz
config *.carrierAggregation.componentCarrier[0].numBands 50
config *.gnb*.cellularNic.numCarriers 1
config *.gnb*.cellularNic.phy.componentCarrierModules "\"carrierAggregation.componentCarrier[0]\""
config *.ue[*].cellularNic.nrPhy.componentCarrierModules "\"carrierAggregation.componentCarrier[0]\""
config *.gnb*.mobility.initialX 800m
config *.gnb*.mobility.initialY 350m
config *.gnb*.cellularNic.antenna.txDirection "\"ANISOTROPIC\""
config *.gnb1.cellularNic.antenna.txAngle 30deg
config *.gnb2.cellularNic.antenna.txAngle 150deg
config *.gnb3.cellularNic.antenna.txAngle 270deg
config *.gnb*.cellularNic.radio.site "\"site1\""
config **.dynamicLos true
config **.shadowing true
config *.gnb*.numX2Apps 2
config *.gnb*.x2App[*].server.localPort "5000 + ancestorIndex(1)"
config *.gnb1.x2App[0].client.connectAddress "\"gnb2%x2ppp0\""
config *.gnb1.x2App[1].client.connectAddress "\"gnb3%x2ppp0\""
config *.gnb2.x2App[0].client.connectAddress "\"gnb1%x2ppp0\""
config *.gnb2.x2App[1].client.connectAddress "\"gnb3%x2ppp1\""
config *.gnb3.x2App[0].client.connectAddress "\"gnb1%x2ppp1\""
config *.gnb3.x2App[1].client.connectAddress "\"gnb2%x2ppp1\""
config *.numUe 6
config **.dynamicCellAssociation true
config **.enableHandover true
config *.ue[*].mobility.typename CircleMobility
config *.ue[*].mobility.cx 800m
config *.ue[*].mobility.cy 350m
config *.ue[*].mobility.r 300m
config *.ue[*].mobility.speed 30mps
config *.ue[*].mobility.startAngle "60deg * ancestorIndex(1)"
config *.ue[*].servingNodeId 0
config *.ue[*].nrServingNodeId 1
config **.routingRecorder.enabled false
config seed-set 0
config **.sctp.**.scalar-recording false
config **.sctp.**.vector-recording false
config **.vector-recording false
config **.sctp.nagleEnabled false
config **.sctp.enableHeartbeats false
config *.configurator.config "xmldoc(\"./demo.xml\")"
config **.downlinkInterference true
config **.uplinkInterference true
config **.ueTxPower 26dBm
config **.eNodeBTxPower 46dBm
config **.mobility.constraintAreaMinX 0m
