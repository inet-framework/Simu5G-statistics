config record-eventlog false
config sim-time-limit 20s
config extends DualConnectivity-VoIP-DL
config description "dual connectivity, MCG bearer stated by its configuration (downlink)"
config *.server.app[*].tos -1
config *.bearerConfigurator.onDemandDrbs "[{coreNetwork: \"epc\", isDefault: true, rlcMode: \"UM\", legs: [\"MCG\"]}]"
config *.ue[*].numApps 1
config *.server.numApps 1
config *.ue[*].app[*].typename VoipReceiver
config *.ue[*].app[*].localPort 3000+ancestorIndex(0)
config *.server.app[*].typename VoipSender
config *.server.app[*].packetSize 40B
config *.server.app[*].destAddress "\"ue[0]\""
config *.server.app[*].localPort 3088+ancestorIndex(0)
config *.server.app[*].destPort 3000+ancestorIndex(0)
config *.server.app[*].startTime uniform(0s,0.02s)
config network simu5g.simulations.nr.networks.SingleCell_withSecondaryGnb
