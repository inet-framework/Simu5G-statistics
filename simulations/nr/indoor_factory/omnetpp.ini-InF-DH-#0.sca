version 3
run InF-DH-0-20261123-09:00:32-5644
attr configname InF-DH
attr datetime 20261123-09:00:32
attr datetimef 20261123-090032
attr experiment InF-DH
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network simu5g.simulations.nr.networks.MultiCell_Standalone
attr processid 5644
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/andras/projects/Simu5G-fork/simu5g-fork/images
config output-scalar-file results/omnetpp.ini-InF-DH-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-InF-DH-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 20s
config extends Hall
config description "factory hall with dense clutter, gNB antennas above the clutter"
config **.radio.scenario "\"INDOOR_FACTORY_DH\""
config *.gnb*.cellularNic.antenna.mobility.offsetZ 8m
config network simu5g.simulations.nr.networks.MultiCell_Standalone
config *.ue[*].mobility.constraintAreaMinX 10m
config *.ue[*].mobility.constraintAreaMinY 10m
config *.ue[*].mobility.constraintAreaMaxX 110m
config *.ue[*].mobility.constraintAreaMaxY 50m
config **.mobility.constraintAreaMinX 0m
config **.mobility.constraintAreaMinY 0m
config **.mobility.constraintAreaMaxX 120m
config **.mobility.constraintAreaMaxY 60m
config **.mobility.constraintAreaMinZ 0m
config **.mobility.constraintAreaMaxZ 0m
config **.mobility.initFromDisplayString false
config *.carrierAggregation.numComponentCarriers 1
config *.carrierAggregation.componentCarrier[0].numerologyIndex 1
config *.carrierAggregation.componentCarrier[0].carrierFrequency 3.5GHz
config *.carrierAggregation.componentCarrier[0].numBands 25
config *.gnb*.cellularNic.numCarriers 1
config *.gnb*.cellularNic.phy.componentCarrierModules "\"carrierAggregation.componentCarrier[0]\""
config *.ue[*].cellularNic.nrPhy.componentCarrierModules "\"carrierAggregation.componentCarrier[0]\""
config **.dynamicLos true
config **.shadowing true
config **.downlinkInterference true
config **.uplinkInterference true
config **.nrChannelModel[*].delayRms 55ns
config **.eNodeBTxPower 24dBm
config **.ueTxPower 23dBm
config *.gnb1.mobility.initialX 30m
config *.gnb1.mobility.initialY 30m
config *.gnb2.mobility.initialX 90m
config *.gnb2.mobility.initialY 30m
config *.gnb*.numX2Apps 1
config *.gnb*.x2App[*].server.localPort "5000 + ancestorIndex(1)"
config *.gnb1.x2App[0].client.connectAddress "\"gnb2%x2ppp0\""
config *.gnb2.x2App[0].client.connectAddress "\"gnb1%x2ppp0\""
config *.numUe 4
config *.ue[*].servingNodeId 0
config *.ue[*].nrServingNodeId 1
config **.dynamicCellAssociation true
config **.enableHandover true
config *.ue[*].mobility.typename RectangleMobility
config *.ue[*].mobility.startPos ancestorIndex(1)
config *.ue[*].mobility.speed 5mps
config *.ue[*].numApps 1
config *.server.numApps 4
config *.ue[*].app[*].typename CbrReceiver
config *.ue[*].app[*].localPort 3000
config *.server.app[*].typename CbrSender
config *.server.app[*].packetSize 1000B
config *.server.app[*].samplingTime 0.0015s
config *.server.app[*].destAddress "\"ue[\" + string(ancestorIndex(0)) + \"]\""
config *.server.app[*].destPort 3000
config *.server.app[*].localPort 3088+ancestorIndex(0)
config *.server.app[*].startTime uniform(0s,0.02s)
config **.routingRecorder.enabled false
config seed-set 0
config **.sctp.**.scalar-recording false
config **.sctp.**.vector-recording false
config **.vector-recording false
config **.sctp.nagleEnabled false
config **.sctp.enableHeartbeats false
config *.configurator.config "xmldoc(\"./demo.xml\")"

