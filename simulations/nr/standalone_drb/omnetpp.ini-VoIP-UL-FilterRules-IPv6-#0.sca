config record-eventlog false
config sim-time-limit 20s
config extends "Ipv6, VoIP-UL-FilterRules"
config *.bearerConfigurator.ulQfiRules "[\n    {ue: \"ue[0]\", filter: \"expr(has(udp) && udp.destPort == 3000)\", qfi: 1},\n    {ue: \"ue[0]\", filter: \"expr(has(udp) && udp.destPort == 3001)\", qfi: 2},\n    {ue: \"ue[0]\", filter: \"expr(has(udp) && udp.destPort == 3002)\", qfi: 3},\n    {ue: \"ue[0]\", filter: \"expr(has(udp) && udp.destPort == 3003)\", qfi: 4},\n    {ue: \"ue[1]\", filter: \"expr(has(udp) && udp.destPort == 3004)\", qfi: 1},\n    {ue: \"ue[1]\", filter: \"expr(has(udp) && udp.destPort == 3005)\", qfi: 2},\n    {ue: \"ue[1]\", filter: \"expr(has(udp) && udp.destPort == 3006)\", qfi: 3},\n    {ue: \"ue[1]\", filter: \"expr(has(udp) && udp.destPort == 3007)\", qfi: 4}]"
config *.ipv6Configurator.typename Ipv6NetworkConfigurator
config *.ipv6Configurator.config "xml(\"<config><interface hosts='**' prefix='2001:db8:0:x::/64'/></config>\")"
config **.ipv6.configurator.networkConfiguratorModule "\"ipv6Configurator\""
