config extends MultiplePairs-TCP-D2D
config *.gnb.cellularNic.mac.schedulingDisciplineUl "\"ALLOCATOR_BESTFIT\""
config *.gnb.cellularNic.mac.reuseD2D true
config *.gnb.cellularNic.mac.conflictGraphUpdatePeriod 1s
config *.gnb.cellularNic.mac.conflictGraphThreshold 90
config extends MultiplePairs-TCP-Infra
config *.ueD2D*[*].cellularNic.d2dInitialMode true
config **.amcMode "\"D2D\""
