config record-eventlog false
config sim-time-limit 20s
config extends SinglePair-TCP-Infra
config *.ueD2D*[*].cellularNic.d2dInitialMode true
config **.amcMode "\"D2D\""
config **.gnb.cellularNic.phy.enableD2DCqiReporting true
config **.usePreconfiguredTxParams false
config **.d2dCqi 7
config **.vector-recording true
config *.ueD2D*[0].numApps 1
config *.ueD2DTx[0].app[*].typename TcpSessionApp
config *.ueD2DTx[0].app[0].connectPort 1000
config *.ueD2DTx[0].app[*].localPort 1000
config *.ueD2DTx[0].app[*].sendBytes 1GiB
config *.ueD2DTx[0].app[0].active true
config *.ueD2DTx[0].app[0].tOpen uniform(0.010s,0.1s)
config *.ueD2DTx[0].app[0].tSend uniform(0.15s,0.5s)
config *.ueD2DTx[0].app[0].connectAddress "\"ueD2DRx[0]\""
config *.ueD2DTx[0].app[0].localAddress "\"ueD2DTx[0]\""
config *.ueD2DRx[0].app[*].typename TcpSinkApp
config *.ueD2DRx[0].app[*].localPort 1000
config **.app[*].tClose -1s
config network simu5g.simulations.nr.networks.SingleCell_Standalone_D2D
config *.gnb.mobility.initialX 300m
config *.gnb.mobility.initialY 300m
config *.numUeCell 0
config *.numUeD2DTx 1
config *.numUeD2DRx 1
config *.ue*[*].servingNodeId 0
config *.ue*[*].nrServingNodeId 1
config *.ueD2DTx[0].mobility.initialX 290m
config *.ueD2DTx[0].mobility.initialY 350m
config *.ueD2DRx[0].mobility.initialX 310m
config *.ueD2DRx[0].mobility.initialY 350m
config warmup-period 0s
config repeat 3
config **.routingRecorder.enabled false
config **.ue*[*].hasD2D true
config *.gnb.hasD2D true
config *.radioMedium.nrChannelModelType "\"Tr38901D2dChannelModel\""
config seed-set 0
config **.mobility.constraintAreaMaxX 1000m
config **.mobility.constraintAreaMaxY 1000m
config **.mobility.constraintAreaMinX 0m
config **.mobility.constraintAreaMinY 0m
config **.mobility.constraintAreaMinZ 0m
config **.mobility.constraintAreaMaxZ 0m
config **.mobility.initFromDisplayString false
