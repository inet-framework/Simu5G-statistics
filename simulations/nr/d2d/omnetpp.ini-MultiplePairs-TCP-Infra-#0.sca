version 3
run MultiplePairs-TCP-Infra-0-20261106-15:19:43-2702375
attr configname MultiplePairs-TCP-Infra
attr datetime 20261106-15:19:43
attr datetimef 20261106-151943
attr experiment MultiplePairs-TCP-Infra
attr inifile omnetpp.ini
attr iterationvars $numPairs=5
attr iterationvarsd numPairs=5
attr iterationvarsf numPairs=5-
