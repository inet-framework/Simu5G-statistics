config *.ueD2D[0].app[*].stopTime 4.9s
config *.ueD2D[0].app[*].destAddress "\"224.0.0.10\""
config *.ueD2D[0].app[*].destPort 1000
config *.ueD2D[1..99].app[*].typename AlertReceiver
config *.ueD2D[1..99].app[*].localPort 1000
config *.eNB*.hasD2D true
config *.ueD2D*[*].hasD2D true
config **.amcMode "\"D2D\""
config **.usePreconfiguredTxParams true
config **.cellularNic.channelModel[0].fading false
config **.cellularNic.channelModel[0].shadowing false
config **.phy.enableMulticastD2DRangeCheck true
config **.phy.multicastD2DRange 500m
config constraint "($rangeCheck == true) || ( ($rangeCheck == false) && ($range == 500m) )"
config sim-time-limit 5s
config warmup-period 0s
config repeat 1
config **.routingRecorder.enabled false
config output-scalar-file "results/checkMulticastRange/$cqi=10, $numUEs=100, $fading=false, $shadowing=false, $rangeCheck=true, $range=500m-0.sca"
