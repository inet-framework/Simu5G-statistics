attr iterationvars "$cqi=10, $numUEs=100, $fading=false, $shadowing=false, $rangeCheck=true, $range=500m"
attr iterationvarsd cqi=10/numUEs=100/fading=false/shadowing=false/rangeCheck=true/range=500m
