itervar cqi 10
itervar fading false
itervar numUEs 100
itervar range 500m
itervar rangeCheck true
itervar shadowing false
config **.param-recording false
config image-path /home/andras/projects/Simu5G-fork/simu5g-fork/images
config output-scalar-file results/omnetpp.ini-checkMulticastRange-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-checkMulticastRange-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 5s
config network simu5g.simulations.lte.networks.SingleCell_D2DMulticast
config **.d2dCqi 10
config *.eNB.mobility.initFromDisplayString false
config *.eNB.mobility.initialX 300m
config *.eNB.mobility.initialY 300m
config *.numUeCell 0
config *.numUeD2D 100
config *.ue*[*].servingNodeId 1
config *.ue*[*].mobility.initFromDisplayString false
config **.ue*[*].mobility.typename LinearMobility
config **.ue*[*].mobility.speed "0.1 mps"
config *.ueD2D[0].mobility.initialX 300m
config *.ueD2D[0].mobility.initialY 350m
config *.ueD2D[1..99].mobility.initialX 300m
config *.ueD2D[1..99].mobility.initialY 350m+(ancestorIndex(1)*10m)
