version 3
run CBR-DL-0-20261123-20:45:25-3591
attr configname CBR-DL
attr datetime 20261123-20:45:25
attr datetimef 20261123-204525
attr experiment CBR-DL
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network simu5g.simulations.lte.networks.ThreeSectorSite
attr processid 3591
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/andras/projects/Simu5G-fork/simu5g-fork/images
config output-scalar-file results/omnetpp.ini-CBR-DL-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-CBR-DL-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 20s
config extends ThreeSectorSite
config description "three sectors of one site; CBR DL traffic to UEs circling the mast"
config *.ue[*].numApps 1
config *.server.numApps 6
config *.ue[*].app[*].typename CbrReceiver
config *.ue[*].app[*].localPort 3000
config *.server.app[*].typename CbrSender
config *.server.app[*].packetSize 100B
config *.server.app[*].samplingTime 0.02s
config *.server.app[*].destAddress "\"ue[\" + string(ancestorIndex(0)) + \"]\""
config *.server.app[*].destPort 3000
config *.server.app[*].localPort 3088+ancestorIndex(0)
config *.server.app[*].startTime uniform(0s,0.02s)
config network simu5g.simulations.lte.networks.ThreeSectorSite
config **.numBands 25
config *.eNodeB*.mobility.initialX 800m
config *.eNodeB*.mobility.initialY 350m
config *.eNodeB*.cellularNic.antenna.txDirection "\"ANISOTROPIC\""
config *.eNodeB1.cellularNic.antenna.txAngle 30deg
config *.eNodeB2.cellularNic.antenna.txAngle 150deg
config *.eNodeB3.cellularNic.antenna.txAngle 270deg
config *.eNodeB*.cellularNic.radio.site "\"site1\""
config **.dynamicLos true
config **.shadowing true
config *.eNodeB*.numX2Apps 2
config *.eNodeB*.x2App[*].server.localPort "5000 + ancestorIndex(1)"
config *.eNodeB1.x2App[0].client.connectAddress "\"eNodeB2%x2ppp0\""
config *.eNodeB1.x2App[1].client.connectAddress "\"eNodeB3%x2ppp0\""
config *.eNodeB2.x2App[0].client.connectAddress "\"eNodeB1%x2ppp0\""
config *.eNodeB2.x2App[1].client.connectAddress "\"eNodeB3%x2ppp1\""
config *.eNodeB3.x2App[0].client.connectAddress "\"eNodeB1%x2ppp1\""
config *.eNodeB3.x2App[1].client.connectAddress "\"eNodeB2%x2ppp1\""
config *.numUe 6
config **.dynamicCellAssociation true
config **.enableHandover true
config *.ue[*].mobility.typename CircleMobility
config *.ue[*].mobility.cx 800m
config *.ue[*].mobility.cy 350m
config *.ue[*].mobility.r 300m
config *.ue[*].mobility.speed 30mps
config *.ue[*].mobility.startAngle "60deg * ancestorIndex(1)"
config *.ue[*].servingNodeId 1
config **.routingRecorder.enabled false
config seed-set 0
config **.sctp.**.scalar-recording false
config **.sctp.**.vector-recording false
config **.vector-recording false
config **.sctp.nagleEnabled false
config **.sctp.enableHeartbeats false
config *.configurator.config "xmldoc(\"./demo.xml\")"
config **.downlinkInterference true
config **.uplinkInterference true
config **.ueTxPower 26dBm
config **.eNodeBTxPower 46dBm
config **.mobility.constraintAreaMinX 0m
config **.mobility.constraintAreaMinY 0m
config **.mobility.constraintAreaMaxX 1300m
config **.mobility.constraintAreaMaxY 700m
config **.mobility.constraintAreaMinZ 0m
config **.mobility.constraintAreaMaxZ 0m
config **.mobility.initFromDisplayString false

