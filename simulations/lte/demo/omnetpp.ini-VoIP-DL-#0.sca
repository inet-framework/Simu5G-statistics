version 3
run VoIP-DL-0-20261123-08:57:45-5113
attr configname VoIP-DL
attr datetime 20261123-08:57:45
attr datetimef 20261123-085745
attr experiment VoIP-DL
attr inifile omnetpp.ini
attr iterationvars $numUEs=5
attr iterationvarsd numUEs=5
attr iterationvarsf numUEs=5-
attr measurement $numUEs=5
attr network simu5g.simulations.lte.networks.SingleCell
attr processid 5113
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar numUEs 5
config **.param-recording false
config image-path /home/andras/projects/Simu5G-fork/simu5g-fork/images
config output-scalar-file results/omnetpp.ini-VoIP-DL-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-VoIP-DL-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 20s
config network simu5g.simulations.lte.networks.SingleCell
config *.configurator.dumpAddresses true
config **.mac.schedulingDisciplineDl "\"MAXCI\""
config **.mac.schedulingDisciplineUl "\"MAXCI\""
config *.ue[*].numApps 1
config *.numUe 5
config **.vector-recording true
config *.server.numApps 5
config **.ue[*].servingNodeId 1
config *.ue[*].mobility.initialMovementHeading "uniform(0deg, 360deg)"
config *.ue[*].mobility.constraintAreaMaxX 1000m
config *.ue[*].mobility.constraintAreaMaxY 1000m
config *.ue[*].mobility.constraintAreaMinX 0m
config *.ue[*].mobility.constraintAreaMinY 0m
config *.ue[*].mobility.initFromDisplayString false
config *.ue[*].mobility.initialX uniform(0m,600m)
config *.ue[*].mobility.initialY uniform(0m,600m)
config *.eNB.mobility.initialX 300m
config *.eNB.mobility.initialY 300m
config *.ue[*].mobility.initialZ 0m
config *.ue[*].mobility.speed 1mps
config *.ue[*].mobility.typename LinearMobility
config *.ue[*].app[0].typename VoipReceiver
config *.ue[*].app[0].localPort 3000
config *.server.app[*].typename VoipSender
config *.server.app[*].packetSize 40B
config *.server.app[*].destAddress "\"ue[\"+string(ancestorIndex(0))+\"]\""
config *.server.app[*].destPort 3000
config *.server.app[*].localPort 3088+ancestorIndex(0)
config *.server.app[*].startTime uniform(0s,0.02s)
config seed-set 0
config **.mobility.constraintAreaMinZ 0m
config **.mobility.constraintAreaMaxZ 0m
config **.mobility.initFromDisplayString true
config **.numBands 6
config **.ueTxPower 26dBm
config **.eNodeBTxPower 40dBm
config *.configurator.config "xmldoc(\"./demo.xml\")"

