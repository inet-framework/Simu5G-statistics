config sim-time-limit 10s
config network simu5g.simulations.lte.networks.SingleCell
config repeat 1
config seed-set 0
config **.ue[*].servingNodeId 1
config *.eNB.mobility.initFromDisplayString false
config *.eNB.mobility.initialX 0m
config *.eNB.mobility.initialY 0m
