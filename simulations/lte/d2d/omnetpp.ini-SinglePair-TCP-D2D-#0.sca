config *.ueD2DTx[0].app[*].sendBytes 1GiB
config *.ueD2DTx[0].app[0].active true
config *.ueD2DTx[0].app[0].tOpen uniform(0.010s,0.1s)
config *.ueD2DTx[0].app[0].tSend uniform(0.15s,0.5s)
config *.ueD2DTx[0].app[0].connectAddress "\"ueD2DRx[0]\""
config *.ueD2DTx[0].app[0].localAddress "\"ueD2DTx[0]\""
config *.ueD2DRx[0].app[*].typename TcpSinkApp
config *.ueD2DRx[0].app[*].localPort 1000
config **.app[*].tClose -1s
config network simu5g.simulations.lte.networks.SingleCell_D2D
config *.eNB.mobility.initFromDisplayString false
config *.eNB.mobility.initialX 300m
config *.eNB.mobility.initialY 300m
config *.numUeCell 0
config *.numUeD2DTx 1
config *.numUeD2DRx 1
config *.ue*[0].servingNodeId 1
config *.ue*[0].mobility.initFromDisplayString false
config *.ueD2DTx[0].mobility.initialX 290m
config *.ueD2DTx[0].mobility.initialY 350m
config *.ueD2DRx[0].mobility.initialX 310m
config *.ueD2DRx[0].mobility.initialY 350m
config warmup-period 0s
config repeat 3
config **.routingRecorder.enabled false
config seed-set 0
config **.vector-recording true
config **.mobility.constraintAreaMinZ 0m
config **.mobility.constraintAreaMaxZ 0m
config **.numBands 50
config *.configurator.config "xmldoc(\"./demo.xml\")"

